{
  "name": "ai-automation",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for AI automation services: bugfix, feature, and maintenance pipelines.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bugfix": "npm run dev -w @ai-auto/bugfix",
    "dev:feature": "npm run dev -w @ai-auto/feature",
    "dev:maintenance": "npm run dev -w @ai-auto/maintenance",
    "start:bugfix": "npm run start -w @ai-auto/bugfix",
    "start:feature": "npm run start -w @ai-auto/feature",
    "start:maintenance": "npm run start -w @ai-auto/maintenance",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:bugfix": "npm run test -w @ai-auto/bugfix"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "typescript": "^7.0.0"
  }
}
