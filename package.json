{
  "name": "jira-bugfix-pipeline",
  "version": "0.1.0",
  "description": "AI-powered Jira bug resolution pipeline: webhook-triggered two-phase (analyze / fix) agent orchestration with human approval gating.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas:export": "tsx scripts/export-schemas.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.27",
    "dotenv": "^17.2.4",
    "fastify": "^5.11.3",
    "mongodb": "^7.5.0",
    "pino": "^10.3.1",
    "simple-git": "^3.28.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "mongodb-memory-server": "^10.4.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.4",
    "vitest": "^4.0.18"
  }
}
