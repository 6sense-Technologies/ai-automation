# Cursor SDK (default agent provider). Get a key at cursor.com/dashboard -> Integrations.
CURSOR_API_KEY=cursor_...

# Jira Cloud REST API credentials (API token from id.atlassian.com).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
#https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=...

# Shared secret the Jira Automation rule sends in the X-Webhook-Secret header.
#openssl rand -hex 32
WEBHOOK_SECRET=change-me-long-random

# API key for the approval/status API (X-Api-Key header).
API_KEY=change-me-long-random-too

# MongoDB: use a dedicated DB name so bugfix state never collides with feature/maintenance.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_bugfix

PORT=3000

# Optional overrides
# CONFIG_PATH=pipeline.config.yaml
# WORK_DIR=~/.ai-automation/bugfix/work
# LOG_LEVEL=info
