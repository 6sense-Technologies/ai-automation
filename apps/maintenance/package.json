{
  "name": "@ai-auto/maintenance",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic dependency vulnerability remediation: npm audit → safe version update → validate → PR (or revert / request manual help). No AI agent.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-auto/config": "*",
    "@ai-auto/errors": "*",
    "@ai-auto/git": "*",
    "@ai-auto/http": "*",
    "@ai-auto/jira": "*",
    "@ai-auto/logger": "*",
    "@ai-auto/mongo": "*",
    "@ai-auto/pipeline-core": "*",
    "@ai-auto/providers": "*",
    "dotenv": "^17.2.4",
    "fastify": "^5.11.3",
    "mongodb": "^7.5.0",
    "pino": "^10.3.1",
    "simple-git": "^3.28.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "mongodb-memory-server": "^10.4.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
