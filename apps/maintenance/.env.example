# Shared secret for POST /webhooks/maintenance (X-Webhook-Secret).
WEBHOOK_SECRET=change-me-long-random

# API key for /api/jobs (X-Api-Key). TeamPulse backend uses this.
API_KEY=change-me-long-random-too

# Optional: create GitHub PRs after successful validation.
# GITHUB_TOKEN=ghp_...

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_maintenance

PORT=3002

# Optional overrides
# CONFIG_PATH=pipeline.config.yaml
# WORK_DIR=~/.ai-automation/maintenance/work
# LOG_LEVEL=info
